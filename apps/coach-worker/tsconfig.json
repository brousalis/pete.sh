{
  "compilerOptions": {
    "target": "ES2022",
    // "dom" is included for types only: the shared web services reference
    // `window` in environment guards. The worker never touches a DOM.
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@petehome/coach-core": ["../../packages/coach-core/src/index.ts"],
      "@petehome/coach-core/*": ["../../packages/coach-core/src/*"],
      // The worker reuses the web app's coach services directly rather than
      // calling over HTTP, so scheduled jobs and chat run identical code.
      "@/*": ["../web/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
