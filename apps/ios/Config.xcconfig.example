// Copy to Config.xcconfig (gitignored) before building the petehome iOS apps.
// Xcode substitutes these into Info.plist; KeychainHelper migrates them
// into the Keychain on first launch.
//
// One machine key. Same value as apps/web/.env PETEWATCH_API_KEY and/or
// COACH_API_KEY (server accepts either as an alias).
//
// Prefer your LAN IP over hostname.local — Windows multi-home + IPv6
// link-local often makes *.local time out in browsers/phones.
// `$()` breaks the `//` so https URLs survive xcconfig parsing.

PETEHOME_API_KEY = replace-with-machine-api-key
PETEHOME_SERVER_URL = https:/$()/192.168.1.4:3000
