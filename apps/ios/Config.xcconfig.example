// Copy to Config.xcconfig (gitignored) before building PeteTrain.
// Xcode substitutes these into Info.plist; KeychainHelper migrates them
// into the Keychain on first launch.
//
// PETEHOME_API_KEY      → POST /api/apple-health/*  (PETEWATCH_API_KEY)
// PETEHOME_COACH_API_KEY → GET  /api/coach/watch/*  (COACH_API_KEY)
// They are different secrets. Do not reuse one for both.

PETEHOME_API_KEY = replace-with-PETEWATCH_API_KEY
PETEHOME_COACH_API_KEY = replace-with-COACH_API_KEY
// `$()` breaks the `//` comment so https URLs survive xcconfig parsing.
PETEHOME_SERVER_URL = https:/$()/www.pete.sh
