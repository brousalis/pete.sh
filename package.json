{
  "name": "petehome-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/coach-worker",
    "packages/coach-core"
  ],
  "description": "petehome — local AI triathlon coach (web PWA + worker + coach-core)",
  "author": "Pete",
  "scripts": {
    "dev": "cd apps/web && yarn dev",
    "dev:https": "cd apps/web && yarn dev:https",
    "build": "cd apps/web && yarn build",
    "start": "cd apps/web && yarn start",
    "start:network": "cd apps/web && yarn start:network",
    "install:web": "cd apps/web && yarn install",

    "p:start": "pm2 start ecosystem.config.js --only petehome",
    "p:stop": "pm2 stop petehome",
    "p:restart": "pm2 restart petehome",
    "p:logs": "pm2 logs petehome",
    "p:logs:pretty": "node apps/web/scripts/pretty-logs.mjs",
    "p:logs:stats": "node apps/web/scripts/pretty-logs.mjs --stats --last 1000",
    "p:status": "pm2 status",

    "p:start:coach": "pm2 start ecosystem.config.js --only petehome-worker",
    "p:stop:coach": "pm2 stop petehome-worker",
    "p:restart:coach": "pm2 restart petehome-worker",
    "p:logs:coach": "pm2 logs petehome-worker",

    "coach:worker": "cd apps/coach-worker && yarn dev",
    "coach:job": "cd apps/coach-worker && yarn job",
    "coach:test": "cd packages/coach-core && yarn test",
    "coach:type-check": "cd packages/coach-core && yarn type-check",
    "coach:doctor": "cd apps/web && yarn coach:doctor",
    "coach:eval": "cd apps/web && yarn coach:eval",

    "lint": "cd apps/web && yarn lint",
    "lint:fix": "cd apps/web && yarn lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "type-check": "cd apps/web && yarn type-check",
    "clean": "cd apps/web && yarn clean",

    "desktop": "cd apps/desktop && yarn start",
    "desktop:build": "cd apps/desktop && yarn build",
    "desktop:install": "cd apps/desktop && yarn install",

    "cli": "cd apps/cli && python -m petehome_cli",
    "migrate": "cd apps/web && yarn migrate",
    "prepare": "husky",

    "db:dump:prod": "node scripts/db-dump-prod.mjs",
    "db:restore:local": "node scripts/db-restore-local.mjs",
    "db:reclone": "yarn db:dump:prod && yarn db:restore:local"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "husky": "^9.0.11",
    "node-notifier": "^10.0.1"
  }
}
